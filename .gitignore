# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
env/
.venv/

# Database (local dev only)
backend/database.db
backend/database_backup_*.db

# Model saved files (large binaries)
backend/model/saved/*.pkl
backend/model/saved/*.joblib
backend/model/saved/metadata.json
backend/model/saved/metadata_*.json

# Dataset images (user uploads)
backend/dataset/raw/*
backend/dataset/processed/*
!backend/dataset/raw/.gitkeep
!backend/dataset/processed/.gitkeep

# Archived / inactive dataset (large image files, not for repository)
backend/dataset/archive_inactive/

# Evaluation results
backend/tests/evaluation_results/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.tmp
*.log
